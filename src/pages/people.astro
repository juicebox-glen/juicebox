---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import VideoBg from "../components/VideoBg.astro";
---

<Layout title="People">
  <Nav />
  <section class="hero people">
    <div class="content__wrapper case"></div>
  </section>
  <section class="work">
    <div class="work_wrapper">
      <div class="work-title">
        <h2 class="h2">PEOPLE</h2>
      </div>
      <div class="work_details">
        <ul role="list" class="list-2 work w-list-unstyled">
          <li class="list-title work">
            <div>SERVICES</div>
          </li>
          <li class="list-item">
            <div class="service case">PHOTOGRAPHY</div>
          </li>
          <li class="list-item">
            <div class="service case">COPYWRITING</div>
          </li>
          <li class="list-item">
            <div class="service case">BRANDING</div>
          </li>
          <li class="list-item">
            <div class="service case">MOTION</div>
          </li>
        </ul>
        <div class="work_intro">
          <p>Honest and timeless bespoke furniture.<br><br>Quanström is a made-to-order furniture company that designs and builds custom furniture with purpose. Built to last, Quanström craftsmanship is functional, minimal, and designed to cross generations.</p>
        </div>
      </div>
      <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3646-4484393a" class="w-layout-layout work_grid wf-layout-layout">
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3647-4484393a" class="w-layout-cell"><img src="/images/image-1_1.jpg" loading="lazy" sizes="100vw" srcset="/images/image-1_1-p-500.jpg 500w, /images/image-1_1-p-800.jpg 800w, /images/image-1_1-p-1080.jpg 1080w, /images/image-1_1.jpg 1440w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3653-4484393a" class="w-layout-cell"><img src="/images/people-.jpg" loading="lazy" sizes="100vw" srcset="/images/people--p-500.jpg 500w, /images/people--p-800.jpg 800w, /images/people--p-1080.jpg 1080w, /images/people-.jpg 1440w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd365f-4484393a" class="w-layout-cell"><img src="/images/plans.avif" loading="lazy" sizes="100vw" srcset="/images/plans-p-500.avif 500w, /images/plans-p-800.avif 800w, /images/plans-p-1080.avif 1080w, /images/plans-p-1600.avif 1600w, /images/plans.avif 3000w" alt=""></div>
        <div class="w-layout-cell">
          <VideoBg video="https://pub-6e9c9d0558e94619893e3ae1137eeec8.r2.dev/videos/upscaled-video.mp4" img="/images/image-4.webp" sizes="100vw" srcset="/images/image-4-p-500.png 500w, /images/image-4-p-800.png 800w, /images/image-4-p-1080.png 1080w, /images/image-4.webp 1440w" />
        </div>
        <div class="w-layout-cell"><img src="/images/image-2.jpg" loading="lazy" sizes="100vw" srcset="/images/image-2-p-500.jpg 500w, /images/image-2-p-800.jpg 800w, /images/image-2-p-1080.jpg 1080w, /images/image-2.jpg 1440w" alt=""></div>
        <div id="w-node-_4e46d753-55c9-db65-bd2c-6db41309ac57-4484393a" class="w-layout-cell"><img src="/images/Artboard.jpg" loading="lazy" sizes="100vw" srcset="/images/Artboard-p-500.jpg 500w, /images/Artboard-p-800.jpg 800w, /images/Artboard-p-1080.jpg 1080w, /images/Artboard-p-1600.jpg 1600w, /images/Artboard-p-2000.jpg 2000w, /images/Artboard-p-2600.jpg 2600w, /images/Artboard.jpg 3000w" alt=""></div>
        <div class="w-layout-cell">
          <div class="work_text">
            <p>Made from honest British wood, in a studio space in Norfolk, this company was born to challenge throw-away culture, using locally sourced, sustainable materials and building products that are not only beautiful but that last.<br><br>All furniture is designed and built by our talented, Dan.</p>
          </div>
        </div>
        <div class="w-layout-cell"><img src="/images/materials.jpg" loading="lazy" sizes="100vw" srcset="/images/materials-p-500.jpg 500w, /images/materials-p-800.jpg 800w, /images/materials-p-1080.jpg 1080w, /images/materials.jpg 1440w" alt=""></div>
        <div id="w-node-_94f218bf-7c86-48a2-7318-804d19e60b76-4484393a" class="w-layout-cell"><img src="/images/station.jpg" loading="lazy" sizes="100vw" srcset="/images/station-p-500.jpg 500w, /images/station-p-800.jpg 800w, /images/station-p-1080.jpg 1080w, /images/station-p-1600.jpg 1600w, /images/station-p-2000.jpg 2000w, /images/station-p-2600.jpg 2600w, /images/station.jpg 3000w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd36ad-4484393a" class="w-layout-cell"><img src="/images/shapes.jpg" loading="lazy" sizes="100vw" srcset="/images/shapes-p-500.jpg 500w, /images/shapes-p-800.jpg 800w, /images/shapes-p-1080.jpg 1080w, /images/shapes.jpg 1440w" alt=""></div>
        <div class="w-layout-cell"><img src="/images/tracing.jpg" loading="lazy" sizes="100vw" srcset="/images/tracing-p-500.jpg 500w, /images/tracing-p-800.jpg 800w, /images/tracing-p-1080.jpg 1080w, /images/tracing.jpg 1440w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd36b9-4484393a" class="w-layout-cell"><img src="/images/image-1.jpg" loading="lazy" sizes="100vw" srcset="/images/image-1-p-500.jpg 500w, /images/image-1-p-800.jpg 800w, /images/image-1-p-1080.jpg 1080w, /images/image-1.jpg 1440w" alt=""></div>
        <div class="w-layout-cell"><img src="/images/shapes_1.jpg" loading="lazy" sizes="100vw" srcset="/images/shapes_1-p-500.jpg 500w, /images/shapes_1-p-800.jpg 800w, /images/shapes_1-p-1080.jpg 1080w, /images/shapes_1.jpg 1440w" alt=""></div>
      </div>
      <div id="footer-line" class="footer-trigger"></div>
    </div>
  </section>
  <Footer />
</Layout>
