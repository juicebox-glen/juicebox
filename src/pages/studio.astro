---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Studio - Juicebox">
  <Nav current="studio" />
  <section class="content studio">
    <div class="content__wrapper">
      <div class="studio_intro">
        <div class="studio_title">
          <h1 class="heading">Purposely small, unashamedly BolD</h1>
        </div>
        <div class="studio_text">
          <p>Juicebox is a creative studio that delivers playful, purposeful work to passionate people.<br><br>Our size is our strength. Between just three of us we specialise in strategy, design, motion, illustration, and copywriting to create memorable brands.</p>
        </div>
      </div>
      <div id="w-node-d543abe3-ef03-0096-f67d-1a1cfa0c9231-4467089d" class="w-layout-layout team_members wf-layout-layout">
        <div class="w-layout-cell"><img src="/images/glen.webp" loading="lazy" sizes="(max-width: 1200px) 100vw, 1200px" srcset="/images/glen-p-500.jpg 500w, /images/glen-p-800.jpg 800w, /images/glen-p-1080.jpg 1080w, /images/glen.webp 1200w" alt="" class="team_photo">
          <div class="team_info">
            <div class="project_name">
              <div class="team_name">GLEN NOBLE</div>
            </div>
            <div class="project_tags">
              <div class="tag">DESIGN</div>
            </div>
          </div>
        </div>
        <div class="w-layout-cell"><img src="/images/spadge.webp" loading="lazy" sizes="(max-width: 1201px) 100vw, 1201px" srcset="/images/spadge-p-500.jpg 500w, /images/spadge-p-800.jpg 800w, /images/spadge-p-1080.jpg 1080w, /images/spadge.webp 1201w" alt="" class="team_photo">
          <div class="team_info">
            <div class="project_name">
              <div class="team_name">SPADGE NUNN</div>
            </div>
            <div class="project_tags">
              <div class="tag alt">COPYWRITING</div>
            </div>
          </div>
        </div>
        <div class="w-layout-cell"><img src="/images/danny.webp" loading="lazy" sizes="(max-width: 1200px) 100vw, 1200px" srcset="/images/danny-p-500.jpg 500w, /images/danny-p-800.jpg 800w, /images/danny-p-1080.jpg 1080w, /images/danny.webp 1200w" alt="" class="team_photo">
          <div class="team_info">
            <div class="project_name">
              <div class="team_name">Danny Quanström</div>
            </div>
            <div class="project_tags">
              <div class="tag">MOTION</div>
            </div>
          </div>
        </div>
      </div>
      <div class="studio__services">
        <div class="services__text studio">
          <p class="service-p">Whether it’s helping brands find their voice, develop their personality, or set them in motion - we’re fluent in all things branding.</p>
        </div>
        <div class="services studio">
          <div class="services_wrapper studio">
            <ul role="list" class="list left w-list-unstyled">
              <li class="list-title">
                <div>SERVICES</div>
              </li>
              <li class="list-item">
                <div class="service studio">Brand IDENTITY</div>
              </li>
              <li class="list-item">
                <div class="service studio">VISUAL DESIGN</div>
              </li>
              <li class="list-item">
                <div class="service studio">COPYWRITING</div>
              </li>
              <li class="list-item">
                <div class="service studio">ILLUSTRATION</div>
              </li>
              <li class="list-item">
                <div class="service studio">MOTION DESIGN</div>
              </li>
            </ul>
            <ul role="list" class="list w-list-unstyled">
              <li class="list-title">
                <div>INDUSTRIES</div>
              </li>
              <li class="list-item">
                <div class="service studio">TECH</div>
              </li>
              <li class="list-item">
                <div class="service studio">ARTS</div>
              </li>
              <li class="list-item">
                <div class="service studio">CULTURE</div>
              </li>
              <li class="list-item">
                <div class="service studio">MUSIC</div>
              </li>
              <li class="list-item">
                <div class="service studio">FASHION</div>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div id="footer-line" class="footer-trigger"></div>
    </div>
  </section>
  <Footer />
</Layout>
