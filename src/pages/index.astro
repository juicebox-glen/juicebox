              <ul role="list" class="list w-list-unstyled">
                <li class="list-title">
                  <div>INDUSTRIES</div>
                </li>
                <li class="list-item">
                  <div class="service">TECH</div>
                </li>
                <li class="list-item">
                  <div class="service">ART</div>
                </li>
                <li class="list-item">
                  <div class="service">CULTURE</div>
                </li>
                <li class="list-item">
                  <div class="service">MUSIC</div>
                </li>
                <li class="list-item">
                  <div class="service">FASHION</div>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="w-layout-cell">
          <a href="/stefon-diggs" class="w-inline-block"><img src="/images/diggs-shape.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 1600px) 90vw, 1440px" srcset="/images/diggs-shape-p-500.jpg 500w, /images/diggs-shape-p-800.jpg 800w, /images/diggs-shape-p-1080.jpg 1080w, /images/diggs-shape.webp 1440w" alt=""></a>
          <div class="project_info">
            <div class="project_name">
