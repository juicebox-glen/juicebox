            </div>
            <div class="project_tags-2">
              <div class="tag">BRANDING</div>
              <div class="tag round">CULTURE</div>
            </div>
          </div>
        </div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd36ad-44670893" class="w-layout-cell">
