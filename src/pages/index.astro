            <div class="work-type">DESIGN</div>
          </div>
          <div class="type">
            <div class="work-type">COPYWRITING</div>
          </div>
          <div class="type">
            <div class="work-type">MOTION</div>
          </div>
        </div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3669-44670893" class="w-layout-cell cell">
