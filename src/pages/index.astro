---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Studio Juicebox" facebookVerification="wyjxai2cksbk4ivyi8h7lhcigk7fg8">
  <Nav current="home" />
  <section class="hero">
    <div class="content_wrapper">
      <div class="video_wrapper">
        <div class="hero_video"><img src="/images/Juice-Jiggle-Optimize.gif" loading="lazy" alt="" class="video"></div>
      </div>
    </div>
  </section>
  <section class="work">
    <div class="work_wrapper">
      <div id="work" class="work_title">
        <h1 class="h1">Fluent in ALL THINGS BRANDING</h1>
      </div>
      <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3646-44670893" class="w-layout-layout work_grid wf-layout-layout">
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3647-44670893" class="w-layout-cell cell">
          <a href="/quanstrom" class="work_image w-inline-block"><img src="/images/quan-2_1.avif" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 1600px) 90vw, 1440px" srcset="/images/quan-2_1quan-2.avif 500w, /images/quan-2_1.avif 1440w" alt=""></a>
          <div class="project_info">
            <div class="project_name">
              <div class="work-title-2">QUANSTROM</div>
            </div>
            <div class="project_tags-2">
              <div class="tag">BRANDING</div>
              <div class="tag round">FURNITURE</div>
            </div>
          </div>
        </div>
        <div class="w-layout-cell cell">
          <a href="/outwrite" class="work_image w-inline-block"><img src="/images/outwrite-mark_1outwrite-mark.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 1600px) 90vw, 1440px" srcset="/images/outwrite-mark_1-p-500.png 500w, /images/outwrite-mark_1-p-800.png 800w, /images/outwrite-mark_1-p-1080.png 1080w, /images/outwrite-mark_1outwrite-mark.webp 1440w" alt=""></a>
          <div class="project_info">
            <div class="project_name">
              <div class="work-title-2">OUTWRITE</div>
            </div>
            <div class="project_tags-2">
              <div class="tag alt">UI/UX</div>
              <div class="tag">BRANDING</div>
              <div class="tag round">TECH</div>
            </div>
          </div>
        </div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd365f-44670893" class="w-layout-cell banner">
