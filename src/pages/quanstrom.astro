---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import VideoBg from "../components/VideoBg.astro";
---

<Layout title="Quanstrom">
  <Nav />
  <section class="hero quan">
    <div class="content__wrapper case"></div>
  </section>
  <section class="work">
    <div class="work_wrapper">
      <div class="work-title">
        <h2 class="h2">QUANSTRöM</h2>
      </div>
      <div class="work_details">
        <ul role="list" class="list-2 work w-list-unstyled">
          <li class="list-title work">
            <div>SERVICES</div>
          </li>
          <li class="list-item">
            <div class="service case">PHOTOGRAPHY</div>
          </li>
          <li class="list-item">
            <div class="service case">COPYWRITING</div>
          </li>
          <li class="list-item">
            <div class="service case">BRANDING</div>
          </li>
          <li class="list-item">
            <div class="service case">MOTION</div>
          </li>
        </ul>
        <div class="work_intro">
          <p>Honest and timeless bespoke furniture.<br><br>Quanström is a made-to-order furniture company that designs and builds custom furniture with purpose. Built to last, Quanström craftsmanship is functional, minimal, and designed to cross generations.</p>
        </div>
      </div>
      <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3646-51ba0660" class="w-layout-layout work_grid wf-layout-layout">
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3647-51ba0660" class="w-layout-cell"><img src="/images/quan-1_1.avif" loading="lazy" sizes="(max-width: 1600px) 90vw, 1440px" srcset="/images/quan-1_1quan-1.avif 500w, /images/quan-1_1.avif 1440w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd3653-51ba0660" class="w-layout-cell"><img src="/images/quan-2_1.avif" loading="lazy" sizes="(max-width: 1600px) 90vw, 1440px" srcset="/images/quan-2_1quan-2.avif 500w, /images/quan-2_1.avif 1440w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd365f-51ba0660" class="w-layout-cell">
          <VideoBg video="https://pub-6e9c9d0558e94619893e3ae1137eeec8.r2.dev/videos/QUAN-STOOL-its-hand-made-v3.mp4" img="/images/video-large.webp" sizes="(max-width: 3333px) 90vw, 3000px" srcset="/images/video-large-p-500.png 500w, /images/video-large-p-800.png 800w, /images/video-large-p-1080.png 1080w, /images/video-large-p-1600.png 1600w, /images/video-large-p-2000.png 2000w, /images/video-large-p-2600.png 2600w, /images/video-large.webp 3000w" />
        </div>
        <div class="w-layout-cell">
          <VideoBg video="https://pub-6e9c9d0558e94619893e3ae1137eeec8.r2.dev/videos/quanbrand.mp4" img="/images/image-4.webp" sizes="(max-width: 1600px) 90vw, 1440px" srcset="/images/image-4-p-500.png 500w, /images/image-4-p-800.png 800w, /images/image-4-p-1080.png 1080w, /images/image-4.webp 1440w" />
        </div>
        <div class="w-layout-cell"><img src="/images/quan-3_1.avif" loading="lazy" sizes="100vw" srcset="/images/quan-3_1quan-3.avif 500w, /images/quan-3_1.avif 1440w" alt=""></div>
        <div id="w-node-_4e46d753-55c9-db65-bd2c-6db41309ac57-51ba0660" class="w-layout-cell">
          <VideoBg video="https://pub-6e9c9d0558e94619893e3ae1137eeec8.r2.dev/videos/New-file-10.mp4" img="/images/video-large.webp" sizes="(max-width: 3333px) 90vw, 3000px" srcset="/images/video-large-p-500.png 500w, /images/video-large-p-800.png 800w, /images/video-large-p-1080.png 1080w, /images/video-large-p-1600.png 1600w, /images/video-large-p-2000.png 2000w, /images/video-large-p-2600.png 2600w, /images/video-large.webp 3000w" />
        </div>
        <div class="w-layout-cell">
          <div class="work_text">
            <p>Made from honest British wood, in a studio space in Norfolk, this company was born to challenge throw-away culture, using locally sourced, sustainable materials and building products that are not only beautiful but that last.<br><br>All furniture is designed and built by our talented, Dan.</p>
          </div>
        </div>
        <div class="w-layout-cell"><img src="/images/quan-4_1.avif" loading="lazy" sizes="(max-width: 1600px) 90vw, 1440px" srcset="/images/quan-4_1quan-4.avif 500w, /images/quan-4_1.avif 1440w" alt=""></div>
        <div id="w-node-_94f218bf-7c86-48a2-7318-804d19e60b76-51ba0660" class="w-layout-cell"><img src="/images/quan-6_1.avif" loading="lazy" sizes="(max-width: 3333px) 90vw, 3000px" srcset="/images/quan-6_1quan-6.avif 500w, /images/quan-6_1quan-6.avif 800w, /images/quan-6_1quan-6.avif 1080w, /images/quan-6_1quan-6.avif 1600w, /images/quan-6_1.avif 3000w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd36ad-51ba0660" class="w-layout-cell">
          <VideoBg video="https://pub-6e9c9d0558e94619893e3ae1137eeec8.r2.dev/videos/quan-desk-square-v3.mp4" img="/images/image-4.webp" sizes="(max-width: 1600px) 90vw, 1440px" srcset="/images/image-4-p-500.png 500w, /images/image-4-p-800.png 800w, /images/image-4-p-1080.png 1080w, /images/image-4.webp 1440w" />
        </div>
        <div class="w-layout-cell"><img src="/images/quan-tee_1.avif" loading="lazy" sizes="(max-width: 1600px) 90vw, 1440px" srcset="/images/quan-tee_1quan-tee.avif 500w, /images/quan-tee_1.avif 1440w" alt=""></div>
        <div id="w-node-_78c4b266-a05d-ee7a-e27b-c4f677bd36b9-51ba0660" class="w-layout-cell"><img src="/images/quan-last_1.avif" loading="lazy" sizes="(max-width: 3333px) 90vw, 3000px" srcset="/images/quan-last_1quan-last.avif 500w, /images/quan-last_1quan-last.avif 800w, /images/quan-last_1quan-last.avif 1080w, /images/quan-last_1quan-last.avif 1600w, /images/quan-last_1.avif 3000w" alt=""></div>
      </div>
      <div id="footer-line" class="footer-trigger"></div>
    </div>
  </section>
  <Footer />
</Layout>
