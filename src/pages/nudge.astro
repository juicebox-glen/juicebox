---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Nudge"
  description="Nudge is a WhatsApp reminder service from Studio Juicebox."
  ogImage="https://cdn.prod.website-files.com/658d74d5cbeb870d23abb1c0/65f9a8941d23baf0cc00c999_icon.png"
>
  <section class="content">
    <div class="content__wrapper privacy nudge">
      <div class="div-block-2">
        <div class="div-block">
          <div><img src="/images/nudge.svg" loading="lazy" alt="" class="image-5"><img src="/images/NUDGE.png" loading="lazy" alt="Nudge" class="image-6"></div>
          <h2 class="heading-3">Nudge is a WhatsApp reminder service from Juicebox.</h2>
        </div>
        <div class="container">Nudge is a WhatsApp-based reminder service created and operated by Studio Juicebox Ltd. Send it anything you don’t want to keep in your head — text or voice note — and it’ll bring it back when it matters. No app to download, no account to create. Just message it like any other contact.</div>
      </div>
      <div>
        <div class="div-block"><img src="/images/Screenshot-2026-08-19-at-08.57.23.png" loading="lazy" sizes="(max-width: 878px) 100vw, 878px" srcset="/images/Screenshot-2026-08-19-at-08.57.23-p-500.png 500w, /images/Screenshot-2026-08-19-at-08.57.23-p-800.png 800w, /images/Screenshot-2026-08-19-at-08.57.23.png 878w" alt=""></div>
      </div>
    </div>
    <section class="footer-dark">
      <div class="container-2">
        <div class="footer-wrapper">
          <a href="#" class="footer-brand w-inline-block"><img src="/images/NUDGE.png" loading="lazy" alt="Nudge" class="image-4"></a>
        </div>
      </div>
      <div class="footer-divider"></div>
      <div class="footer-copyright-center">Nudge is a product of Studio Juicebox Ltd</div>
    </section>
  </section>
</Layout>
